{
  "name": "@yashsharmaa/codefast-linux-x64",
  "version": "0.2.10",
  "description": "The codefast binary for Linux on x86-64 (static). Install @yashsharmaa/codefast instead: it selects this package.",
  "homepage": "https://github.com/YashSharmaa/codefast",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashSharmaa/codefast.git",
