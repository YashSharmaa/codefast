  },
  "license": "(MIT OR Apache-2.0)",
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "bin/codefast"
  ],
  "codefast": {
    "target": "x86_64-unknown-linux-musl"
  }
}
