{
  "name": "@yashsharmaa/codefast-linux-arm64",
  "version": "0.2.2",
  "description": "The codefast binary for Linux on arm64 (static). Install @yashsharmaa/codefast instead: it selects this package.",
  "homepage": "https://github.com/YashSharmaa/codefast",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashSharmaa/codefast.git",
    "directory": "npm/platforms/linux-arm64"
  },
  "license": "(MIT OR Apache-2.0)",
  "os": [
    "linux"
  ],
  "cpu": [
    "arm64"
  ],
  "files": [
    "bin/codefast"
  ],
  "codefast": {
    "target": "aarch64-unknown-linux-musl"
  }
}
