import sys
from typing import Any, Generic, Iterator, Self, TypeVar, overload

from _typeshed import StrPath
from . import _core

_T = TypeVar("_T")
VERSION: str
DEBUG: bool = ...

def connect(path: StrPath, timeout: float = ..., *, uri: bool = ...) -> Connection: ...
async def aconnect(path: StrPath) -> Connection: ...

class Connection:
    isolation_level: str | None
    row_factory: Any
    def __init__(self, path: StrPath) -> None: ...
    def cursor(self) -> Cursor: ...
    def __enter__(self) -> Self: ...
    @property
    def in_transaction(self) -> bool: ...
    @overload
    def execute(self, sql: str) -> Cursor: ...
    @overload
    def execute(self, sql: str, parameters: tuple[Any, ...]) -> Cursor: ...
    @classmethod
    def from_core(cls, handle: _core.Handle) -> Self: ...
    @staticmethod
    def escape(value: str) -> str: ...

class Cursor(Iterator[_T], Generic[_T]):
    connection: Connection
    def fetchone(self) -> _T | None: ...
    def close(self) -> None:
        """Close the cursor."""

if sys.version_info >= (3, 11):
    def backup(target: Connection, *, pages: int = ...) -> None: ...
